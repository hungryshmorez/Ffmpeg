{
  "name": "ffmpeg-studio",
  "version": "10.4.0",
  "private": true,
  "description": "Browser-based video/audio editor using ffmpeg.wasm + WebCodecs",
  "scripts": {
    "test": "node .test/roundtrip.mjs downscale-480p 5",
    "test:1x": "node .test/roundtrip.mjs downscale-480p 1",
    "test:5x": "node .test/roundtrip.mjs downscale-480p 5",
    "test:workflows": "node .test/workflows.mjs",
    "test:compositor": "node .test/compositor.mjs",
    "test:shortcuts": "node .test/shortcuts.mjs",
    "test:workflows-v4v5": "node .test/workflows-v4v5.mjs",
    "test:bin-features": "node .test/bin-features.mjs",
    "test:audio-studio": "node .test/audio-studio.mjs",
    "test:clips": "node .test/clips.mjs",
    "test:mobile": "node .test/mobile.mjs",
    "test:panic": "node .test/panic.mjs",
    "test:mosh-family": "node .test/mosh-family.mjs",
    "test:datamosh2": "node .test/datamosh2.mjs",
    "test:databend": "node .test/databend.mjs",
    "test:pixelsort": "node .test/pixelsort.mjs",
    "test:feedback": "node .test/feedback.mjs",
    "test:flow-displace": "node .test/flow-displace.mjs",
    "test:vector-overlay": "node .test/vector-overlay.mjs",
    "changelog": "node scripts/generate-changelog.js",
    "verify": "node -c app.js && node -c build-info.js && node -c pipeline.js && node -c .test/roundtrip.mjs && node scripts/generate-changelog.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.61.1"
  }
}
